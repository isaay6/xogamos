{
	"name": "plataforma-reservas",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:demo": "DEMO=1 IDENTITY_MODE=simulated AUTH_SECRET=dev-only-secret-not-for-production-000 vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;EUPL-1.2;MPL-2.0;Unlicense;CC0-1.0;BlueOak-1.0.0;OFL-1.1;Python-2.0;CC-BY-4.0\"",
		"spdx": "node scripts/check-spdx.mjs",
		"check:bundle": "node scripts/check-bundle.mjs",
		"db:seed": "tsx scripts/seed.ts",
		"db:migrate": "node scripts/migrate.mjs",
		"operator": "node scripts/create-operator.mjs",
		"start": "node scripts/migrate.mjs && node build",
		"test:a11y": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.1",
		"@electric-sql/pglite": "^0.5.10",
		"@playwright/test": "^1.49.1",
		"@sveltejs/adapter-node": "6.0.1",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "22.20.5",
		"@types/nodemailer": "^8.0.2",
		"drizzle-kit": "^0.31.11",
		"license-checker-rseidelsohn": "4.4.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "5.57.2",
		"svelte-check": "^4.6.0",
		"tsx": "4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"license": "EUPL-1.2",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@date-fns/tz": "1.5.0",
		"@fontsource/gabarito": "5.3.0",
		"date-fns": "4.4.0",
		"drizzle-orm": "^0.45.4",
		"jsqr": "1.4.0",
		"jose": "6.2.17",
		"nodemailer": "^10.2.1",
		"postgres": "^3.4.9",
		"uqr": "0.1.3",
		"zod": "4.6.7"
	}
}
