# Conexión obrigatoria á base PostgreSQL; en Docker usa o nome do servizo db.
DATABASE_URL=postgres://reservas:troca-este-contrasinal@db:5432/reservas
# Segredo obrigatorio (QR das reservas, hash do DNI e identidade simulada); xérao con openssl rand -base64 48.
AUTH_SECRET=troca-este-segredo-por-un-valor-longo-e-aleatorio
# Modo de identidade opcional; deixe baleiro para a integración real.
IDENTITY_MODE=
# Orixe pública opcional para os QR, sen barra final.
PUBLIC_ORIGIN=https://reservas.exemplo.gal
# Cabeceira que envía o proxy HTTPS co protocolo orixinal (Caddy e nginx usan x-forwarded-proto).
# Sen ela, a aplicación supón HTTPS. Necesaria para que os formularios funcionen tras o proxy.
PROTOCOL_HEADER=x-forwarded-proto
# Cabeceira coa IP real que engade o proxy. Sen ela, todas as persoas parecerían ter a IP do
# proxy e compartirían o mesmo límite de peticións.
ADDRESS_HEADER=x-forwarded-for
# Número de proxies de confianza diante da aplicación (1 se só hai Caddy ou nginx).
XFF_DEPTH=1
# Tamaño máximo do corpo HTTP (512 KiB deixa marxe sobre as imaxes permitidas de 256 KiB).
BODY_SIZE_LIMIT=512K
# URL SMTP opcional para enviar avisos; sen ela só se gardan no buzón da aplicación.
SMTP_URL=
# Remitente opcional dos avisos por correo; por defecto é avisos@localhost.
MAIL_FROM=avisos@reservas.exemplo.gal
# Modo demo opcional: deixe baleiro nunha instalación normal.
DEMO=
# Confirmación obrigatoria só coa demo sobre PostgreSQL; nunca a use con datos reais.
DEMO_DATABASE_IS_DISPOSABLE=
# Usuario obrigatorio de PostgreSQL para Docker Compose.
POSTGRES_USER=reservas
# Contrasinal obrigatorio de PostgreSQL para Docker Compose; substitúa este exemplo.
POSTGRES_PASSWORD=troca-este-contrasinal
# Nome obrigatorio da base de PostgreSQL para Docker Compose.
POSTGRES_DB=reservas

# Só para demostracións: estes datos borraranse ou poden modificarse libremente.
# DEMO=1
# IDENTITY_MODE=simulated
# DEMO_DATABASE_IS_DISPOSABLE=1

# Porto do equipo onde se publica a aplicación (por defecto 3000). Só escoita en 127.0.0.1:
# o acceso desde fóra vai sempre polo proxy HTTPS.
APP_PORT=3000

# Imaxe publicada e versión que se executa. Deixe latest para a última publicación.
XOGAMOS_IMAGE=ghcr.io/isaay6/xogamos
XOGAMOS_VERSION=latest
# Dominio e correo para o certificado HTTPS automático de Caddy.
XOGAMOS_DOMAIN=reservas.exemplo.gal
XOGAMOS_EMAIL=tecnica@reservas.exemplo.gal
# Hora local da copia diaria e días de conservación. As tres copias máis novas consérvanse sempre.
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=14
