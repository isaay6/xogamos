# Copia este ficheiro como deploy/demo/.env no servidor e enche os valores.
# Os signos $ dos valores escríbense dobres ($$), porque Docker Compose os interpreta.

# Enderezo público. Sen dominio propio, usa sslip.io coa IP do servidor:
# a IP 1.2.3.4 queda como 1-2-3-4.sslip.io (HTTPS automático con Let's Encrypt).
DEMO_HOST=1-2-3-4.sslip.io

# Contrasinal temporal da demo (Caddyfile.privado). Usuario e hash bcrypt:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'O-TEU-CONTRASINAL'
DEMO_USER=xurado
DEMO_PASS_HASH=$$2a$$14$$substitue-polo-hash
# Caddyfile.privado (con contrasinal) ou Caddyfile.publico (aberta).
CADDYFILE=Caddyfile.privado

# Base de datos (só datos ficticios; pódese borrar cando se queira).
POSTGRES_USER=xogamos
POSTGRES_PASSWORD=cambia-isto
POSTGRES_DB=xogamos
DATABASE_URL=postgres://xogamos:cambia-isto@db:5432/xogamos

# Segredo da aplicación: openssl rand -base64 48
AUTH_SECRET=cambia-isto-por-un-segredo-longo

# Sen correo saínte na demo.
SMTP_URL=
MAIL_FROM=avisos@localhost

# Valores fixos da demo (o compose.demo.yml xa os impón; aquí só evitan avisos).
DEMO=1
IDENTITY_MODE=simulated
DEMO_DATABASE_IS_DISPOSABLE=1
PUBLIC_ORIGIN=https://localhost
